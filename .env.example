# Copier en .env et adapter. Ne jamais versionner .env
DEBUG=1
SECRET_KEY=changez-moi
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://votre-domaine
# PostgreSQL (production) : si POSTGRES_DB est défini, PostgreSQL est utilisé (pip install psycopg[binary])
# POSTGRES_DB=ciat
# POSTGRES_USER=ciat
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# IA générative : laisser vide = mode démonstration (aucun modèle interrogé)
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
